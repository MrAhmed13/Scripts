function Groupbox:AddParagraph(title, content)
	local row = Row(0, true)
	
	New("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = row,
	})

	local titleLabel = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Library.FontBold,
		Text = tostring(title or ""),
		TextColor3 = Library.Scheme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		LayoutOrder = 1,
		Parent = row,
	})
	Library:Register(titleLabel, "TextColor3", "Text")

	local contentLabel = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Library.Font,
		Text = tostring(content or ""),
		TextColor3 = Library.Scheme.SubText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		LineHeight = 1.25,
		LayoutOrder = 2,
		Parent = row,
	})
	Library:Register(contentLabel, "TextColor3", "SubText")

	-- sync row height to the list layout's absolute content size
	local listLayout = row:FindFirstChildWhichIsA("UIListLayout")
	local function syncHeight()
		row.Size = UDim2.new(1, 0, 0, listLayout.AbsoluteContentSize.Y)
	end
	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(syncHeight)
	task.spawn(syncHeight)

	local obj = { Type = "Paragraph", Instance = row }
	function obj:SetTitle(t)
		titleLabel.Text = tostring(t)
	end
	function obj:SetContent(c)
		contentLabel.Text = tostring(c)
	end
	function obj:SetText(t, c)
