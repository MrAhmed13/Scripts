	-- Sidebar footer: quiet version stamp so the panel does not end abruptly.
	local footer = New("TextLabel", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -9),
		Size = UDim2.new(1, -24, 0, 12),
