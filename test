	--------------------------------------------------------------------
	-- Sidebar
	--------------------------------------------------------------------
	local Sidebar = New("Frame", {
		Name = "Sidebar",
		Position = UDim2.new(0, 0, 0, Library.Metrics.Topbar),
		Size = UDim2.new(0, Library.Metrics.Sidebar, 1, -Library.Metrics.Topbar),
